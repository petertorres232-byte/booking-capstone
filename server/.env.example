# ==============================================================================
# APEX PERFORMANCE BACKEND — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to server/.env and replace placeholders with real credentials.
# NEVER put real passwords or API keys inside .env.example!
# ==============================================================================

# 1. Server Runtime Configuration
PORT=5000
NODE_ENV=development

# 2. MongoDB Atlas Connection String (Must specify /apex_performance database)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@apexcluster.xxxxx.mongodb.net/apex_performance?retryWrites=true&w=majority

# 3. Authentication & JWT Signing Configuration
JWT_SECRET=replace_with_64_char_cryptographic_hex_string
JWT_EXPIRES_IN=7d

# 4. CORS Allowed Frontend Origin (Vite default port 5173 locally)
CLIENT_ORIGIN=http://localhost:5173

# --- AI Provider (Google Gemini) ---
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=10000